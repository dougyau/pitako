{
  "profiles": ["coding", "analysis"],
  "defaultProfile": "coding",
  "pitakoExtension": "extensions/index.ts",
  "required": [
    {
      "id": "pi-lsp-client",
      "spec": "github:code-yeongyu/pi-lsp-client#1c981dfcacc456fe4ce9f4120a2f0250b54d6844",
      "entry": "node_modules/pi-lsp-client/src/index.ts",
      "tools": [
        "lsp_diagnostics",
        "lsp_goto_definition",
        "lsp_find_references",
        "lsp_symbols",
        "lsp_prepare_rename",
        "lsp_rename"
      ]
    },
    {
      "id": "@vndv/pi-codegraph",
      "spec": "@vndv/pi-codegraph@0.1.10",
      "entry": "extensions/code-intelligence/codegraph-raw.ts",
      "bin": "codegraph",
      "tools": [
        "codegraph_search",
        "codegraph_callers",
        "codegraph_callees",
        "codegraph_impact",
        "codegraph_explore",
        "codegraph_node",
        "codegraph_status",
        "codegraph_files"
      ]
    },
    {
      "id": "pitako-code-intelligence",
      "spec": "pitako",
      "entry": "extensions/code-intelligence/index.ts",
      "tools": ["project_report", "read_symbol", "read_enclosing", "module_report", "inspect_symbol", "review_surface"]
    },
    {
      "id": "@juicesharp/rpiv-todo",
      "spec": "@juicesharp/rpiv-todo@2.11.0",
      "entry": "node_modules/@juicesharp/rpiv-todo/index.ts",
      "tools": ["todo"]
    },
    {
      "id": "pitako-board",
      "spec": "pitako",
      "entry": "extensions/board/index.ts",
      "tools": [
        "board_topic_create",
        "board_topic_list",
        "board_topic_read",
        "board_topic_update",
        "board_post",
        "board_query"
      ]
    },
    {
      "id": "pitako-agent",
      "spec": "pitako",
      "entry": "extensions/agent/index.ts",
      "tools": ["agent_run"]
    },
    {
      "id": "billion-context-pi",
      "spec": "billion-context-pi@0.1.83",
      "entry": "extensions/acp.ts",
      "tools": ["compress", "search_context", "decompress", "acp_status", "acp_cache"]
    },
    {
      "id": "pi-hermes-memory",
      "spec": "pi-hermes-memory@0.9.9",
      "entry": "node_modules/pi-hermes-memory/src/index.ts",
      "tools": ["memory_add", "memory_replace", "memory_remove", "memory_search", "session_search", "skill_manage"]
    },
    {
      "id": "pi-web-access",
      "spec": "pi-web-access@0.31.0",
      "entry": "node_modules/pi-web-access/dist/index.js",
      "tools": ["web_search", "fetch_content", "source_check", "get_search_content", "web_enable"]
    },
    {
      "id": "pi-codex-tools",
      "spec": "pi-codex-tools@0.3.0",
      "entry": "node_modules/pi-codex-tools/index.ts",
      "tools": ["apply_patch"]
    }
  ],
  "optional": []
}
