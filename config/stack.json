{
  "profiles": ["coding", "analysis"],
  "defaultProfile": "coding",
  "pitakoExtension": "extensions/index.ts",
  "required": [
    {
      "id": "pi-codex-tools",
      "spec": "pi-codex-tools@0.4.0",
      "entry": "node_modules/pi-codex-tools/index.ts",
      "tools": ["apply_patch"]
    },
    {
      "id": "pitako-profile-policy",
      "spec": "pitako",
      "entry": "extensions/profile-policy.ts",
      "tools": []
    },
    {
      "id": "pi-lsp-client",
      "spec": "github:code-yeongyu/pi-lsp-client#9d029fb32b721c038b58fb418b98bbfcf720cf0a",
      "entry": "node_modules/pi-lsp-client/src/index.ts",
      "bins": ["typescript-language-server", "pyright-langserver", "intelephense"],
      "tools": [
        "lsp_diagnostics",
        "lsp_goto_definition",
        "lsp_find_references",
        "lsp_symbols",
        "lsp_prepare_rename",
        "lsp_rename"
      ]
    },
    {
      "id": "@vndv/pi-codegraph",
      "spec": "@vndv/pi-codegraph@0.1.11",
      "entry": "node_modules/@vndv/pi-codegraph/extensions/codegraph.ts",
      "bins": ["codegraph"],
      "tools": [
        "codegraph_search",
        "codegraph_callers",
        "codegraph_callees",
        "codegraph_impact",
        "codegraph_explore",
        "codegraph_node",
        "codegraph_status",
        "codegraph_files"
      ]
    },
    {
      "id": "@nicknisi/pi-ast-grep",
      "spec": "@nicknisi/pi-ast-grep@0.3.4",
      "entry": "node_modules/@nicknisi/pi-ast-grep/index.ts",
      "bins": ["ast-grep"],
      "tools": ["ast_search", "ast_rewrite"]
    },
    {
      "id": "pitako-dev-tools",
      "spec": "pitako",
      "entry": "extensions/dev-tools/index.ts",
      "tools": [
        "git_worktree_list",
        "git_worktree_add",
        "git_worktree_remove",
        "git_worktree_prune",
        "git_status",
        "git_diff",
        "git_log",
        "git_show",
        "git_commit",
        "ssh_exec",
        "ssh_pull",
        "ssh_push",
        "py_lint",
        "py_format",
        "py_typecheck",
        "py_test",
        "py_uv",
        "cargo_check",
        "cargo_clippy",
        "cargo_fmt",
        "cargo_test",
        "cargo_build",
        "cargo_run",
        "cargo_doc",
        "cargo_bench",
        "cargo_add",
        "resource_snapshot"
      ]
    },
    {
      "id": "pitako-file-sha256",
      "spec": "pitako",
      "entry": "extensions/file-sha256.ts",
      "tools": ["file_sha256", "file_sha256_save"]
    },
    {
      "id": "pitako-checkpoint",
      "spec": "pitako",
      "entry": "extensions/checkpoint-create.ts",
      "tools": ["checkpoint_create"]
    },
    {
      "id": "@juicesharp/rpiv-todo",
      "spec": "@juicesharp/rpiv-todo@2.15.0",
      "entry": "extensions/todo.ts",
      "tools": ["todo"]
    },
    {
      "id": "pitako-board",
      "spec": "pitako",
      "entry": "extensions/board/index.ts",
      "tools": [
        "board_topic_create",
        "board_topic_list",
        "board_topic_read",
        "board_topic_update",
        "board_post",
        "board_query"
      ]
    },
    {
      "id": "pi-subagents",
      "spec": "pi-subagents@0.83.0",
      "entry": "node_modules/pi-subagents/bundle/index.js",
      "tools": ["subagent", "subagents_enable", "bg_wait", "subagent_supervisor", "contact_supervisor"]
    },
    {
      "id": "billion-context-pi",
      "spec": "billion-context-pi@0.1.83",
      "entry": "extensions/acp.ts",
      "tools": ["compress", "search_context", "decompress", "acp_status", "acp_cache"]
    },
    {
      "id": "pi-hermes-memory",
      "spec": "pi-hermes-memory@0.9.11",
      "entry": "node_modules/pi-hermes-memory/src/index.ts",
      "tools": ["memory_add", "memory_replace", "memory_remove", "memory_search", "session_search", "skill_manage"]
    },
    {
      "id": "pi-web-access",
      "spec": "pi-web-access@0.45.0",
      "entry": "node_modules/pi-web-access/dist/index.js",
      "tools": ["web_search", "fetch_content", "source_check", "get_search_content", "web_enable"]
    },
    {
      "id": "pi-markdown-preview",
      "spec": "pi-markdown-preview@0.25.0",
      "entry": "node_modules/pi-markdown-preview/index.ts",
      "tools": ["preview_export"]
    },
    {
      "id": "@juicesharp/rpiv-ask-user-question",
      "spec": "@juicesharp/rpiv-ask-user-question@2.15.0",
      "entry": "node_modules/@juicesharp/rpiv-ask-user-question/index.ts",
      "tools": ["ask_user_question"]
    }
  ],
  "optional": []
}
