+// Only todo's helper graph is retained; mocks use Bun instead of Vitest.
+import type { Api, Model } from "@earendil-works/pi-ai";
+import type {
+	ExtensionAPI,
+	ExtensionCommandContext,
+	ExtensionToolContext,
+	ExtensionUIContext,
+	RegisteredCommand,
