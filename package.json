{
  "name": "pitako",
  "version": "0.1.0",
  "description": "Opinionated Pi coding baseline: LSP, CodeGraph, Ponytail, selected Caveman and pstack skills, and coding/analysis profiles.",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package", "pi", "coding-agent", "pitako"],
  "engines": {
    "node": ">=22.19.0",
    "bun": ">1.4.2"
  },
  "files": [
    "extensions",
    "skills",
    "prompts",
    "config",
    "agents",
    "fixtures",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY.md"
  ],
  "scripts": {
    "test": "bun test --parallel",
    "pi": "pi --no-extensions --approve -e .",
    "typecheck": "node node_modules/typescript-compiler/bin/tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts",
      "./node_modules/pi-codex-tools/index.ts",
      "./extensions/profile-policy.ts",
      "./node_modules/pi-lsp-client/src/index.ts",
      "./node_modules/@vndv/pi-codegraph/extensions/codegraph.ts",
      "./node_modules/@nicknisi/pi-ast-grep/index.ts",
      "./extensions/dev-tools/index.ts",
      "./extensions/file-sha256.ts",
      "./extensions/checkpoint-create.ts",
      "./extensions/todo.ts",
      "./extensions/board/index.ts",
      "./node_modules/pi-subagents/bundle/index.js",
      "./extensions/acp.ts",
      "./node_modules/pi-hermes-memory/src/index.ts",
      "./node_modules/pi-web-access/dist/index.js",
      "./node_modules/pi-markdown-preview/index.ts",
      "./node_modules/@juicesharp/rpiv-ask-user-question/index.ts"
    ],
    "skills": [
      "./skills/pitako-coding",
      "./skills/architecture",
      "./skills/review",
      "./skills/plan",
      "./skills/execute",
      "./skills/grilling",
      "./skills/pre-pr",
      "./skills/remove-ai-slops",
      "./skills/caveman",
      "./skills/investigate-first",
      "./skills/language/rust-best-practices",
      "./skills/language/rust-review",
      "./skills/language/rust-port",
      "./skills/practical",
      "./skills/principles",
      "./node_modules/@dietrichgebert/ponytail/skills/ponytail",
      "./node_modules/@dietrichgebert/ponytail/skills/ponytail-review"
    ],
    "prompts": ["./prompts"],
    "subagents": {
      "agents": ["./agents"]
    }
  },
  "dependencies": {
    "@ast-grep/cli": "0.51.0",
    "@colbymchenry/codegraph": "1.6.2",
    "@dietrichgebert/ponytail": "5.3.2",
    "@juicesharp/rpiv-ask-user-question": "2.15.0",
    "@juicesharp/rpiv-todo": "2.15.0",
    "@nicknisi/pi-ast-grep": "0.3.4",
    "@vndv/pi-codegraph": "0.1.11",
    "billion-context-pi": "0.1.83",
    "intelephense": "1.18.5",
    "pi-codex-tools": "0.4.0",
    "pi-hermes-memory": "0.9.11",
    "pi-lsp-client": "github:code-yeongyu/pi-lsp-client#9d029fb32b721c038b58fb418b98bbfcf720cf0a",
    "pi-markdown-preview": "0.25.0",
    "pi-subagents": "0.83.0",
    "pi-web-access": "0.45.0",
    "pyright": "1.1.414",
    "smol-toml": "1.9.1",
    "typescript": "5.9.3",
    "typescript-language-server": "5.3.0"
  },
  "bundledDependencies": [
    "@ast-grep/cli",
    "@dietrichgebert/ponytail",
    "@juicesharp/rpiv-ask-user-question",
    "@juicesharp/rpiv-todo",
    "@nicknisi/pi-ast-grep",
    "@vndv/pi-codegraph",
    "pi-lsp-client",
    "pi-codex-tools",
    "billion-context-pi",
    "pi-hermes-memory",
    "pi-markdown-preview",
    "pi-subagents",
    "pi-web-access"
  ],
  "trustedDependencies": [
    "@ast-grep/cli"
  ],
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=1.4.0",
    "@earendil-works/pi-ai": ">=1.4.0",
    "@earendil-works/pi-coding-agent": ">=1.4.0",
    "@earendil-works/pi-tui": ">=1.4.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@juicesharp/rpiv-i18n": "2.15.0",
    "@types/bun": "1.4.4",
    "typescript-compiler": "npm:typescript@7.0.2",
    "typebox": "1.4.3"
  }
}
