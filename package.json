{
  "name": "pitako",
  "version": "0.1.0",
  "description": "Opinionated Pi coding baseline: LSP, CodeGraph, Ponytail, selected Caveman and pstack skills, and coding/analysis profiles.",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package", "pi", "coding-agent", "pitako"],
  "engines": {
    "node": ">=22.19.0",
    "bun": ">1.4.2"
  },
  "files": [
    "extensions",
    "skills",
    "prompts",
    "config",
    "agents",
    "fixtures",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY.md"
  ],
  "scripts": {
    "test": "bun test --parallel",
    "pi": "pi --no-extensions --approve -e .",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts",
      "./node_modules/pi-codex-tools/index.ts",
      "./extensions/profile-policy.ts",
      "./node_modules/pi-lsp-client/src/index.ts",
      "./node_modules/@vndv/pi-codegraph/extensions/codegraph.ts",
      "./node_modules/@nredd/pi-dev-tools/src/index.ts",
      "./extensions/file-sha256.ts",
      "./extensions/todo.ts",
      "./extensions/board/index.ts",
      "./node_modules/pi-subagents/bundle/index.js",
      "./extensions/acp.ts",
      "./node_modules/pi-hermes-memory/src/index.ts",
      "./node_modules/pi-web-access/dist/index.js"
    ],
    "skills": [
      "./skills/pitako-coding",
      "./skills/architecture",
      "./skills/review",
      "./skills/plan",
      "./skills/execute",
      "./skills/grilling",
      "./skills/pre-pr",
      "./skills/remove-ai-slops",
      "./skills/caveman",
      "./skills/investigate-first",
      "./skills/practical",
      "./skills/principles",
      "./node_modules/@dietrichgebert/ponytail/skills/ponytail",
      "./node_modules/@dietrichgebert/ponytail/skills/ponytail-review"
    ],
    "prompts": ["./prompts"],
    "subagents": {
      "agents": ["./agents"]
    }
  },
  "dependencies": {
    "@colbymchenry/codegraph": "1.6.0",
    "@dietrichgebert/ponytail": "4.10.0",
    "@juicesharp/rpiv-todo": "2.11.0",
    "@nredd/pi-dev-tools": "0.6.0",
    "@nredd/pi-resource-sampler": "0.1.1",
    "@vndv/pi-codegraph": "0.1.10",
    "billion-context-pi": "0.1.83",
    "pi-codex-tools": "0.3.0",
    "pi-hermes-memory": "0.9.9",
    "pi-lsp-client": "github:code-yeongyu/pi-lsp-client#1c981dfcacc456fe4ce9f4120a2f0250b54d6844",
    "pi-subagents": "0.82.0",
    "pi-web-access": "0.42.0"
  },
  "bundledDependencies": [
    "@dietrichgebert/ponytail",
    "@juicesharp/rpiv-todo",
    "@nredd/pi-dev-tools",
    "@nredd/pi-resource-sampler",
    "@vndv/pi-codegraph",
    "pi-lsp-client",
    "pi-codex-tools",
    "billion-context-pi",
    "pi-hermes-memory",
    "pi-subagents",
    "pi-web-access"
  ],
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=1.4.0",
    "@earendil-works/pi-ai": ">=1.4.0",
    "@earendil-works/pi-coding-agent": ">=1.4.0",
    "@earendil-works/pi-tui": ">=1.4.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@juicesharp/rpiv-i18n": "2.11.0",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
