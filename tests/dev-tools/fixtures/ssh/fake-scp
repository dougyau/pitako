#!/bin/sh
# Stand-in for scp: copies between `host:path` and local paths on this machine.
while [ $# -gt 0 ]; do
  case "$1" in
    --) shift; break ;;
    -o) shift 2 ;;
    -*) shift ;;
    *) break ;;
  esac
done
src="$1"; dst="$2"
strip() { printf '%s' "$1" | sed 's/^[^:]*://'; }
case "$src" in *:*) src=$(strip "$src") ;; esac
case "$dst" in *:*) dst=$(strip "$dst") ;; esac
[ -f "$src" ] || { echo "scp: $src: No such file or directory" >&2; exit 1; }
cp "$src" "$dst"
